# .ebextensions/cloudwatch-agent.config
packages:
  yum:
    amazon-cloudwatch-agent: []   # install CloudWatch Agent

files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "agent": {
          "metrics_collection_interval": 60,
          "run_as_user": "root"
        },
        "metrics": {
          "metrics_collected": {
            "mem": {
              "measurement": [
                "mem_used_percent"
              ],
              "metrics_collection_interval": 60
            }
          }
        }
      }

commands:
  01-fix-perms:
      command: |
        chown -R root:root /opt/aws/amazon-cloudwatch-agent

  02-fetch-config:
      command: |
        sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
          -a fetch-config \
          -m ec2 \
          -c ssm:_CLOUDWATCH_CONFIG_PARAMETER_ \
          -s || echo "SSM fetch failed, continuing with default config"

  03-copy-config:
      command: |
        sudo cp /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.d/ssm__CLOUDWATCH_CONFIG_PARAMETER_ /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

  04-enable-cwagent:
      command: |
        sudo systemctl enable amazon-cloudwatch-agent
        sudo systemctl restart amazon-cloudwatch-agent
